{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "cliproxyapi",
  "presets": {
    "cliproxyapi": {
      "orchestrator": {
        "model": "cliproxyapi/gpt-6-astra",
        "variant": "high",
        "mcps": ["*"]
      },
      "oracle": {
        "model": "cliproxyapi/gpt-6-astra",
        "variant": "high",
        "mcps": ["*"]
      },
      "librarian": {
        "model": "cliproxyapi/gpt-5.6-sol",
        "variant": "high",
        "mcps": ["context7", "exa", "gh_grep"]
      },
      "explorer": {
        "model": "cliproxyapi/gpt-5.6-sol",
        "variant": "high",
        "mcps": []
      },
      "designer": {
        "model": "cliproxyapi/kimi-k3-256k",
        "variant": "xhigh",
        "mcps": []
      },
      "fixer": {
        "model": "cliproxyapi/gpt-5.6-sol",
        "variant": "xhigh",
        "mcps": []
      },
      "observer": {
        "model": "cliproxyapi/gpt-5.6-sol",
        "variant": "high",
        "mcps": []
      },
      "council": {
        "model": "cliproxyapi/gpt-5.6-sol",
        "variant": "xhigh",
        "mcps": ["*"]
      }
    }
  },
  "council": {
    "timeout": 1200000,
    "presets": {
      "default": {
        "reviewer": {
          "model": "cliproxyapi/gpt-6-astra",
          "variant": "high"
        },
        "coding-alpha": {
          "model": "cliproxyapi/gpt-6-astra",
          "variant": "xhigh"
        }
      }
    }
  },
  "companion": {
    "enabled": false
  },
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 50
  },
  "disabled_mcps": [
    "websearch"
  ]
}
